# ============================================================
# Canopy — Environment Variables
# Copy to .env and fill in your values
# ============================================================

# Database (PostgreSQL connection string)
# For local: postgresql://user:password@localhost:5432/canopy
# For cloud: use your provider's connection string (Supabase, Neon, Railway, etc.)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/canopy?schema=public"

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth (for production JWT signing)
JWT_SECRET="change-this-to-a-random-64-char-secret-in-production"

# Google SMTP (for email verification)
# Create an App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-google-app-password"
SMTP_FROM="Your App <your-email@gmail.com>"

# Google OAuth (optional)
# Set up at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# API Integrations (mocked for MVP)
# CLIMATIQ_API_KEY=""
# PLAID_CLIENT_ID=""
# PLAID_SECRET=""
# GOOGLE_MAPS_API_KEY=""
